# Copy to .env and adjust. Everything here is optional; defaults are built in.

# --- Monitoring server (server/index.ts) ---
PORT=3001
# Fixed seed makes the simulated plant repeatable (handy for demos and bug reports).
# Leave empty for a different run every start.
SIM_SEED=
# Seconds of history the simulator pre-generates at start, so trends are full at once.
BACKFILL_S=900
# Tick period in milliseconds (1000 = 1 Hz, like a typical AMS scan).
TICK_MS=1000

# --- Dashboard (Vite) ---
# By default the dashboard talks to /api and /ws on its own origin, which the
# Vite dev server and nginx both proxy to the monitoring server. Set these only
# to point the browser somewhere else.
# VITE_WS_URL=ws://192.168.1.50:3001/ws
# VITE_API_URL=http://192.168.1.50:3001/api/v1
# Where the Vite dev/preview proxy forwards to (default http://localhost:3001).
# AEGIS_SERVER=http://localhost:3001
